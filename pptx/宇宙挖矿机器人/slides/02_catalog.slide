<Slide type="catalog">
  <Box style={{ width: '100%', height: '100%', background: '#0B1120', flexDirection: 'row' }}>
    <Box style={{ width: '33%', justifyContent: 'center', padding: '0 52px', background: '#0F1B33' }}>
      <Text style={{ fontSize: 46, color: '#E5EDF7', fontWeight: 'bold', lineHeight: 1.1 }}>目录<Text style={{ color: '#22D3EE' }}><br/>CONTENTS</Text></Text>
      <Text style={{ fontSize: 16, color: '#94A3B8', marginTop: 24, lineHeight: 1.6 }}>从家用清扫到地外采矿<br/>的完整技术闭环</Text>
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center', padding: '0 56px', gap: 26 }}>
      <Animation animType="fadeIn" duration={600}>
        <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'center' }}>
          <Text style={{ fontSize: 36, color: '#3B82F6', fontWeight: 'bold' }}>01</Text>
          <Box><Text style={{ fontSize: 24, color: '#E5EDF7', fontWeight: 'bold' }}>项目总览</Text><Text style={{ fontSize: 15, color: '#94A3B8' }}>系统整体架构 · 改装逻辑</Text></Box>
        </Box>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'center' }}>
          <Text style={{ fontSize: 36, color: '#22D3EE', fontWeight: 'bold' }}>02</Text>
          <Box><Text style={{ fontSize: 24, color: '#E5EDF7', fontWeight: 'bold' }}>机器结构与抗辐射芯片</Text><Text style={{ fontSize: 15, color: '#94A3B8' }}>扫地机器人底座 · 改装结构 · 西电三代半</Text></Box>
        </Box>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'center' }}>
          <Text style={{ fontSize: 36, color: '#F59E0B', fontWeight: 'bold' }}>03</Text>
          <Box><Text style={{ fontSize: 24, color: '#E5EDF7', fontWeight: 'bold' }}>通讯与数据闭环</Text><Text style={{ fontSize: 15, color: '#94A3B8' }}>近地轨道 Starlink · 集尘盒区块链售卖</Text></Box>
        </Box>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'center' }}>
          <Text style={{ fontSize: 36, color: '#94A3B8', fontWeight: 'bold' }}>04</Text>
          <Box><Text style={{ fontSize: 24, color: '#E5EDF7', fontWeight: 'bold' }}>仿真验证与展望</Text><Text style={{ fontSize: 15, color: '#94A3B8' }}>三场景演示结果 · GitHub 发布</Text></Box>
        </Box>
      </Animation>
    </Box>
  </Box>
</Slide>
