<Slide type="content">
  <Box style={{ width: '100%', height: '100%', background: '#0B1120', flexDirection: 'row' }}>
    <Box style={{ width: '55%', height: '100%', justifyContent: 'center', alignItems: 'center', padding: '40px' }}>
      <Image src="assets/starlink_coverage.svg" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center', padding: '0 52px', gap: 14 }}>
      <Animation animType="fadeIn" duration={600}>
        <Text style={{ fontSize: 30, color: '#E5EDF7', fontWeight: 'bold' }}>近地轨道 Starlink 覆盖</Text>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.8 }}>近地轨道区域可接入 Musk 星链星座，过顶窗口轮替供网，深空段由信使号中继补盲。</Text>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ gap: 12, marginTop: 4 }}>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 15, color: '#CBD5E1' }}>通讯覆盖率</Text><Text style={{ fontSize: 15, color: '#22D3EE', fontWeight: 'bold' }}>~100%（仿真）</Text></Box>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 15, color: '#CBD5E1' }}>链路时延</Text><Text style={{ fontSize: 15, color: '#22D3EE', fontWeight: 'bold' }}>28 – 61 ms</Text></Box>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 15, color: '#CBD5E1' }}>离线缓存</Text><Text style={{ fontSize: 15, color: '#22D3EE', fontWeight: 'bold' }}>store-and-forward 队列</Text></Box>
          <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}><Text style={{ fontSize: 15, color: '#CBD5E1' }}>资产发布</Text><Text style={{ fontSize: 15, color: '#22D3EE', fontWeight: 'bold' }}>星链回传成交</Text></Box>
        </Box>
      </Animation>
    </Box>
  </Box>
</Slide>
