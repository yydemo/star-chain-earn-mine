<Slide type="content">
  <Box style={{ width: '100%', height: '100%', background: '#0B1120', flexDirection: 'row' }}>
    <Box style={{ width: '60%', height: '100%', justifyContent: 'center', padding: '0 56px', gap: 14 }}>
      <Animation animType="fadeIn" duration={600}>
        <Text style={{ fontSize: 30, color: '#E5EDF7', fontWeight: 'bold' }}>集尘盒识别 → 区块链售卖</Text>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.85 }}>集尘盒装满后，机载摄像头生成真实图像，识别材质并铸造为可售区块链资产，经星链成交后上链，全程可溯源。</Text>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ gap: 10, marginTop: 4 }}>
          <Text style={{ fontSize: 15, color: '#CBD5E1', lineHeight: 1.7 }}>① 集尘盒满 → 摄像头成像（真实 PNG 快照）</Text>
          <Text style={{ fontSize: 15, color: '#CBD5E1', lineHeight: 1.7 }}>② 材质分类：金属矿 / 硅酸盐 / 水冰（准确率 100%）</Text>
          <Text style={{ fontSize: 15, color: '#CBD5E1', lineHeight: 1.7 }}>③ 每批铸造资产（LOT 编号 + 市场估价 ¥）</Text>
          <Text style={{ fontSize: 15, color: '#CBD5E1', lineHeight: 1.7 }}>④ 星链回传成交 → 上链（asset + sale 区块）</Text>
        </Box>
      </Animation>
    </Box>
    <Box style={{ width: '40%', height: '100%', justifyContent: 'center', padding: '0 40px', gap: 16 }}>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ background: '#0F1B33', border: '1px solid #1E3A5F', borderRadius: 12, padding: 20 }}>
          <Text style={{ fontSize: 16, color: '#34D399', fontWeight: 'bold' }}>溯源能力</Text>
          <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 6, lineHeight: 1.7 }}>任一矿样沿链回溯到机器人 / 坐标 / 品位 / 哈希</Text>
        </Box>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ background: '#0F1B33', border: '1px solid #1E3A5F', borderRadius: 12, padding: 20 }}>
          <Text style={{ fontSize: 16, color: '#F59E0B', fontWeight: 'bold' }}>完整性</Text>
          <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 6, lineHeight: 1.7 }}>SHA256 哈希链，篡改即校验失败</Text>
        </Box>
      </Animation>
    </Box>
  </Box>
</Slide>
