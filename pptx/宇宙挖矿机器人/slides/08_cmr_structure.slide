<Slide type="content">
  <Box style={{ width: '100%', height: '100%', background: '#0B1120', flexDirection: 'column' }}>
    <Box style={{ height: '56%', justifyContent: 'center', alignItems: 'center', padding: '24px 40px 0' }}>
      <Image src="assets/cmr_structure.svg" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center', padding: '0 48px 36px', gap: 14 }}>
      <Animation animType="fadeIn" duration={600}>
        <Text style={{ fontSize: 30, color: '#E5EDF7', fontWeight: 'bold', textAlign: 'center' }}>整体改装结构：四层叠加</Text>
      </Animation>
      <Animation animType="fadeIn" startType="afterPrevious" duration={600}>
        <Box style={{ flexDirection: 'row', gap: 14 }}>
          <Box style={{ flex: 1, background: '#0F1B33', border: '1px solid #1E3A5F', borderRadius: 12, padding: 16 }}><Text style={{ fontSize: 17, color: '#3B82F6', fontWeight: 'bold' }}>不锈钢外壳层</Text><Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 6, lineHeight: 1.6 }}>316L 机身，抗辐照与散热骨架</Text></Box>
          <Box style={{ flex: 1, background: '#0F1B33', border: '1px solid #1E3A5F', borderRadius: 12, padding: 16 }}><Text style={{ fontSize: 17, color: '#22D3EE', fontWeight: 'bold' }}>抗辐射算力层</Text><Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 6, lineHeight: 1.6 }}>西电 / 广州三代半电源-算力主板</Text></Box>
          <Box style={{ flex: 1, background: '#0F1B33', border: '1px solid #1E3A5F', borderRadius: 12, padding: 16 }}><Text style={{ fontSize: 17, color: '#F59E0B', fontWeight: 'bold' }}>工具头层</Text><Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 6, lineHeight: 1.6 }}>多光谱相机 + 钻采机构</Text></Box>
          <Box style={{ flex: 1, background: '#0F1B33', border: '1px solid #1E3A5F', borderRadius: 12, padding: 16 }}><Text style={{ fontSize: 17, color: '#34D399', fontWeight: 'bold' }}>通信层</Text><Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 6, lineHeight: 1.6 }}>星链天线 + 区块链账本</Text></Box>
        </Box>
      </Animation>
    </Box>
  </Box>
</Slide>
